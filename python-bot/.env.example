# Instagram secondary account (NOT your main account)
IG_USERNAME=your_secondary_username
IG_PASSWORD=your_secondary_password

# Groq
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# How often to check for new DMs (seconds)
POLL_INTERVAL=8

# Max messages of history to send to the AI
MAX_HISTORY=10
